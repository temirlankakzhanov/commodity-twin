# Copy to .env for local runs. Never commit .env. All values are optional.

# FRED API key (free at https://fredaccount.stlouisfed.org/apikeys). Without it the app uses
# the public CSV endpoint.
FRED_API_KEY=

# Directories (defaults shown)
# MTWIN_CACHE_DIR=.cache/mtwin
# MTWIN_SNAPSHOT_DIR=data/snapshots

# Network behaviour
# MTWIN_OFFLINE=0            # 1 = never call external APIs
# MTWIN_HTTP_TIMEOUT_S=8
# MTWIN_HTTP_RETRIES=2
# MTWIN_CACHE_TTL_HOURS=12

# Optional Yahoo Finance fallback. Yahoo's terms restrict it to personal use: leave it off for a
# public deployment.
# MTWIN_ENABLE_YAHOO=0
